# Скопируйте в .env и заполните. Пустые значения обязательны для своей фазы.

# --- Общее -----------------------------------------------------------------
TZ=Europe/Moscow
# UID/GID пользователя, от которого монтируется rclone (id -u / id -g)
PUID=1000
PGID=1000
# Какие профили запускать: пусто = только navidrome+caddy; discovery; ai
COMPOSE_PROFILES=

# Точка монтирования Google Диска (rclone, см. rclone/rclone-music.service)
MUSIC_DIR=/mnt/music
# Папка, внутри которой лежит MUSIC_DIR. Контейнеры монтируют её, чтобы переживать перезапуск rclone
MUSIC_PARENT=/mnt
# Локальный буфер на SSD для загрузок Soulseek
BUFFER_DIR=/srv/music-buffer

# --- Версии образов (обновлять вместе, особенно Navidrome и AudioMuse-AI) ---
NAVIDROME_VERSION=0.64.2
CADDY_VERSION=2.10
FEISHIN_VERSION=1.17.0
LIDARR_VERSION=3.1.0.4875-ls43
SOULARR_VERSION=1.2.2
SLSKD_VERSION=0.26.1
EXPLO_VERSION=v1.2.0
# Без AVX2 на процессоре используйте 3.6.3-noavx2
AUDIOMUSE_VERSION=3.6.3
AUDIOMUSE_PLUGIN_VERSION=v10
LYRICS_PLUGIN_VERSION=v8.1.0

# --- Фаза 1: доступ снаружи -------------------------------------------------
ND_DOMAIN=music.example.com
ACME_EMAIL=
# 443, если порт свободен. На сервере с remnanode (Xray на 443) поставьте 8443
HTTPS_PORT=443
# Веб-интерфейсы slskd, Explo, AudioMuse-AI, Feishin: https://<ND_DOMAIN>:<порт>
SLSKD_HTTPS_PORT=11111
EXPLO_HTTPS_PORT=22222
AUDIOMUSE_HTTPS_PORT=33333
# Веб-плеер Feishin
FEISHIN_HTTPS_PORT=44444
# Lidarr (дискографии исполнителей)
LIDARR_HTTPS_PORT=55555

# --- Фаза 2: Last.fm (https://www.last.fm/api/account/create) ----------------
LASTFM_API_KEY=
LASTFM_SECRET=

# --- Фаза 3: Soulseek и Explo ----------------------------------------------
SLSK_USERNAME=
SLSK_PASSWORD=
SLSK_LISTEN_PORT=50300
SLSKD_WEB_USERNAME=admin
SLSKD_WEB_PASSWORD=
# openssl rand -hex 24
SLSKD_API_KEY=
SLSKD_DOWNLOAD_SLOTS=3
SLSKD_UPLOAD_SLOTS=2
SLSKD_UPLOAD_SPEED_LIMIT_KIB=2048
EXPLO_UI_USERNAME=admin
EXPLO_UI_PASSWORD=

# --- Фаза 4: AudioMuse-AI ---------------------------------------------------
AUDIOMUSE_DB_USER=audiomuse
AUDIOMUSE_DB_PASSWORD=
AUDIOMUSE_WORKER_MEM_LIMIT=4g
