# Копируется в data/soularr/config.ini скриптом install-plugins.sh.
# Заполните два api_key. Пути совпадают с MUSIC_DIR=/mnt/music из .env.
# Полный список опций: https://github.com/mrusse/soularr/blob/main/config.ini

[Lidarr]
# Lidarr → Settings → General → API Key
api_key =
host_url = http://lidarr:8686
download_dir = /mnt/music/soulseek
disable_sync = False

[Slskd]
# SLSKD_API_KEY из .env
api_key =
host_url = http://slskd:5030
url_base = /
download_dir = /mnt/music/soulseek
delete_searches = True
# проход ждёт, пока докачаются все его альбомы: медленный пир держит всю очередь.
# Не скачалось — альбом вернётся через сутки (soularr_plus.py), и ответит другой пир.
stalled_timeout = 2400
# пир так и не начал отдавать (длинная очередь) — через 15 минут сдаёмся
remote_queue_timeout = 900

[Release Settings]
use_selected_lidarr_release = False
use_most_common_tracknum = True
allow_multi_disc = True
accepted_countries = Europe,Japan,United Kingdom,United States,[Worldwide],Australia,Canada,Russia
skip_region_check = False
accepted_formats = CD,Digital Media,Vinyl

[Search Settings]
search_timeout = 15000
maximum_peer_queue = 50
minimum_peer_upload_speed = 0
minimum_filename_match_ratio = 0.8
minimum_search_interval = 5
# Сначала MP3 320, затем FLAC
allowed_filetypes = mp3 320,flac 16/44.1,flac,mp3
ignored_users =
# Искать «Исполнитель Альбом»: по одному названию альбома слишком много мусора
album_prepend_artist = True
# priority — очередь soularr_plus.py: свежедобавленные исполнители, альбомы, EP, затем синглы;
# ненайденное повторяется с паузой. Оригинальные значения (incrementing_page и др.) тоже работают.
search_type = priority
number_of_albums_to_grab = 15
# ищется подстрокой: просто «live» отсекало бы и «Alive», «Deliver», «Oliver»
title_blacklist = (live,[live, - live,live at the ,live in concert,karaoke,(instrumental,[instrumental,instrumental version
search_blacklist =
search_source = missing
failed_import_denylist = True

[Download Settings]
download_filtering = True
use_extension_whitelist = False
extensions_whitelist = lrc,nfo,txt
rename_download_folders = True

[Logging]
level = INFO
format = [%(levelname)s|%(module)s|L%(lineno)d] %(asctime)s: %(message)s
datefmt = %Y-%m-%dT%H:%M:%S%z
log_to_file = True
log_file = soularr.log
max_bytes = 1048576
backup_count = 3
