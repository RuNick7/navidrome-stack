# Скопируйте в explo/explo.env. Полный список опций: https://github.com/LumePart/Explo/blob/main/sample.env

LISTENBRAINZ_USER=
LISTENBRAINZ_USER_TOKEN=
LISTENBRAINZ_DISCOVERY=playlist

EXPLO_SYSTEM=subsonic
SYSTEM_URL=http://navidrome:4533
SYSTEM_USERNAME=
SYSTEM_PASSWORD=
TRACK_MATCH_SCORE=60

# Сначала Soulseek (оригинальные MP3 320/FLAC), YouTube как запасной.
# YouTube-треки Explo перекодирует ffmpeg в MP3 со стандартным битрейтом.
DOWNLOAD_SERVICES=slskd,youtube
USE_SUBDIRECTORY=true
PATH_TEMPLATE={{Artist}}/{{Album}}/{{File}}
EMBED_COVER_ART=true
COVER_ART_SIZE=500
FILTER_LIST=live,remix,instrumental,extended,acapella

SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=
SLSKD_MIGRATE_DOWNLOADS=true
EXTENSIONS=mp3,flac
MIN_BITRATE=256

SINGLE_ARTIST=true
PLAYLISTNAME_FORMAT=week
LOG_LEVEL=INFO
